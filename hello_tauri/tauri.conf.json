{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hello_tauri",
  "version": "0.1.0",
  "identifier": "com.kotaoue.hello-tauri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Hello World for Tauri",
        "width": 320,
        "height": 240
      }
    ],
    "security": {
      "csp": "default-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
